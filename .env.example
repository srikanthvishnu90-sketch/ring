# Ring — API keys & platform access
# Copy to `.env` and fill in. NEVER commit `.env`.
# This file is the full inventory: every key the app needs for peak functionality.

# ------------------------------------------------------------------
# Agent brain — pick one provider
# ------------------------------------------------------------------
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AGENT_MODEL=gpt-4o

# ------------------------------------------------------------------
# Google: Gmail (read + send) and Calendar — OAuth 2.0
# Get from: Google Cloud Console → APIs & Services → Credentials
# Enable: Gmail API, Google Calendar API. Configure the OAuth consent
# screen; scopes requested: gmail.readonly, gmail.send, calendar.events
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ------------------------------------------------------------------
# Rides: Uber
# REALITY CHECK: Uber has no public self-serve ride-request API
# (request-a-ride was partner-whitelist only). What works TODAY:
# deep links that open the Uber app with pickup/dropoff prefilled —
# see backend/connectors/uber.js. Direct in-app booking needs an
# Uber partnership / Uber for Business agreement (business track).
# ------------------------------------------------------------------
UBER_CLIENT_ID=                # optional — partnership track only
UBER_CLIENT_SECRET=
UBER_SERVER_TOKEN=             # optional — fare/time estimates only

# ------------------------------------------------------------------
# Dining
# OpenTable: partner-only API. Apply: https://dev.opentable.com/partner-portal
# (business justification + agreement required). Until then: deep links.
# Resy: NO public API (partner-only). The web app's internal api.resy.com
# endpoints are reverse-engineered and fragile — supported here as an
# explicit opt-in advanced path, not the default. Default: deep links.
# Tock: no public API — deep links only.
# ------------------------------------------------------------------
OPENTABLE_PARTNER_ID=
OPENTABLE_API_KEY=
RESY_API_KEY=                  # advanced/unofficial path only
RESY_AUTH_TOKEN=               # per-user token minted from a Resy login

# ------------------------------------------------------------------
# Places & maps — restaurant discovery, details, photos, geocoding
# Get from: Google Cloud Console → Places API (New)
# ------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# ------------------------------------------------------------------
# Data + realtime — chat threads, group chats, memory, approvals
# Postgres directly, or Supabase (Postgres + Auth + Realtime + Storage)
# ------------------------------------------------------------------
DATABASE_URL=                  # postgres://… (or leave empty if using Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ------------------------------------------------------------------
# Push notifications — approvals & group-chat mentions on the phone
# APNs: Apple Developer → Certificates, Identifiers & Profiles → Keys
# FCM: Firebase Console → Project settings → Cloud Messaging
# ------------------------------------------------------------------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=                      # contents of the .p8 key
APNS_BUNDLE_ID=
FCM_SERVER_KEY=

# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=                # random 32+ chars: openssl rand -hex 32
