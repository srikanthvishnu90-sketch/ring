# Ring — API keys & platform access
# Copy to `.env` and fill in. NEVER commit `.env`.
# This file is the full inventory: every key the app needs for peak functionality.

# ------------------------------------------------------------------
# Agent brain — pick one provider
# ------------------------------------------------------------------
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works. Free option: a Gemini key from
# Google AI Studio → OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# and AGENT_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
AGENT_MODEL=gpt-4o

# ------------------------------------------------------------------
# Google: Gmail (read + send) and Calendar — OAuth 2.0
# Get from: Google Cloud Console → APIs & Services → Credentials
# Enable: Gmail API, Google Calendar API. Configure the OAuth consent
# screen; scopes requested: gmail.readonly, gmail.send, calendar.events
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ------------------------------------------------------------------
# Rides: Uber
# REALITY CHECK: Uber has no public self-serve ride-request API
# (request-a-ride was partner-whitelist only). What works TODAY:
# deep links that open the Uber app with pickup/dropoff prefilled —
# see backend/connectors/uber.js. Direct in-app booking needs an
# Uber partnership / Uber for Business agreement (business track).
# ------------------------------------------------------------------
UBER_CLIENT_ID=                # optional — partnership track only
UBER_CLIENT_SECRET=
UBER_SERVER_TOKEN=             # optional — fare/time estimates only

# ------------------------------------------------------------------
# Dining
# OpenTable: partner-only API. Apply: https://dev.opentable.com/partner-portal
# (business justification + agreement required). Until then: deep links.
# Resy: NO public API (partner-only). The web app's internal api.resy.com
# endpoints are reverse-engineered and fragile — supported here as an
# explicit opt-in advanced path, not the default. Default: deep links.
# Tock: no public API — deep links only.
# ------------------------------------------------------------------
OPENTABLE_PARTNER_ID=
OPENTABLE_API_KEY=
RESY_API_KEY=                  # advanced/unofficial path only
RESY_AUTH_TOKEN=               # per-user token minted from a Resy login

# ------------------------------------------------------------------
# Places & maps — restaurant discovery, details, photos, geocoding
# Get from: Google Cloud Console → Places API (New)
# ------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# ------------------------------------------------------------------
# Telegram — bot messaging
# Get from: @BotFather in Telegram → /newbot → token.
# Webhook: POST https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook
#   with url=https://<your-domain>/api/telegram/webhook
#   and secret_token=<TELEGRAM_WEBHOOK_SECRET> (any random string, e.g. openssl rand -hex 32).
# Telegram delivers secret_token as the X-Telegram-Bot-Api-Secret-Token header;
# the server rejects anything else with 403. ?secret= still works for manual curl tests.
# Inbound messages land in per-sender threads in the app.
# ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=          # random string; gates the webhook route

# ------------------------------------------------------------------
# Stripe — payment links + invoices (never direct card charges)
# Get from: Stripe Dashboard → Developers → API keys.
# **Use a RESTRICTED key, not the secret key:**
#   Developers → API keys → Restricted keys → Create
#   Scope it to exactly: Payment Links (write), Invoices (write),
#   Customers (write), Balance (read). Nothing else.
# A restricted key cannot refund, transfer, or touch payouts, so even a
# leaked key can't drain the account. This connector never accepts card
# numbers — there is no card input anywhere in the module.
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=                # restricted key, rk_live_... / rk_test_...

# ------------------------------------------------------------------
# Data + realtime — chat threads, group chats, memory, approvals
# Postgres directly, or Supabase (Postgres + Auth + Realtime + Storage)
# ------------------------------------------------------------------
DATABASE_URL=                  # postgres://… (or leave empty if using Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ------------------------------------------------------------------
# Push notifications — approvals & group-chat mentions on the phone
# APNs: Apple Developer → Certificates, Identifiers & Profiles → Keys
# FCM: Firebase Console → Project settings → Cloud Messaging
# ------------------------------------------------------------------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=                      # contents of the .p8 key
APNS_BUNDLE_ID=
FCM_SERVER_KEY=

# ------------------------------------------------------------------
# Webhooks — smart home / automation bridge (backend/connectors/webhooks.js)
# ------------------------------------------------------------------
# Outbound: named webhooks the agent can fire (medium risk — acts on the
# physical world, goes through the confirm gate like calendar_create).
# RING_WEBHOOKS is a JSON object: name -> {url, method, headers}.
# Secrets live in headers here; this variable stays server-side, never
# reaches the client or the model. Server-side SSRF guard refuses
# private/loopback/link-local targets and non-http(s) schemes.
# RING_WEBHOOKS={"living_room_lamp":{"url":"https://maker.ifttt.com/trigger/lamp/with/key/abc","method":"POST","headers":{"Content-Type":"application/json"}}}
RING_WEBHOOKS=

# Inbound: lets external services (Home Assistant, etc.) push events into
# Ring via POST /api/webhooks/in/:name. JSON object: name -> secret.
# Send the secret as ?secret=... or the X-Webhook-Secret header.
# Valid events land in the "Automations" thread. Unknown name → 404,
# wrong secret → 403.
# RING_INBOUND_SECRETS={"front_door":"a-long-random-secret"}
RING_INBOUND_SECRETS=

# ------------------------------------------------------------------
# Twilio — SMS + WhatsApp messaging (connector: backend/connectors/twilio.js)
# Get from: Twilio Console → Account Info (SID + auth token), and
# Phone Numbers → Manage → Active numbers (your Twilio number, E.164)
# Webhook: set your Twilio number's messaging webhook to
#   <APP_URL>/api/twilio/inbound
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=             # your Twilio number, E.164 e.g. +15551234567

# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=                # random 32+ chars: openssl rand -hex 32
